# ===========================================
# AirSight Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ===========================================
# Required API Keys
# ===========================================

# OpenAQ API Key (get from https://openaq.org)
OPENAQ_API_KEY=your_openaq_api_key_here

# Cerebras API Key (for ultra-fast inference)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Raindrop API Key (LiquidMetal AI platform)
RAINDROP_API_KEY=your_raindrop_api_key_here

# ===========================================
# Optional API Keys (for future extensions)
# ===========================================

# WorkOS (authentication)
# WORKOS_CLIENT_ID=your_workos_client_id
# WORKOS_API_KEY=your_workos_api_key

# Stripe (payments)
# STRIPE_API_KEY=your_stripe_api_key

# Vultr (cloud compute)
# VULTR_API_KEY=your_vultr_api_key

# ===========================================
# App Settings
# ===========================================

# Enable debug mode (true/false)
DEBUG=false

# Cache TTL in seconds
CACHE_TTL_SECONDS=300

# Default search radius in meters
DEFAULT_RADIUS_METERS=25000

# Maximum results per query
MAX_RESULTS=100

